{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:megabrain:prompt-master:v1",
  "title": "Prompt Master v1 (structural, not runtime authorization)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "project_id", "objective", "scope", "allowed_operations", "prohibited_operations", "context_refs", "acceptance_criteria", "resource_policy", "approval_requirements", "output_contract", "evidence_requirements", "expires_at", "authorization_ref"],
  "$defs": {
    "text": {"type": "string", "pattern": "\\S"},
    "texts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}}
  },
  "properties": {
    "schema_version": {"const": "megabrain.prompt-master.v1"},
    "task_id": {"type": "string", "pattern": "^MB-[A-Z0-9-]{8,90}$"},
    "project_id": {"$ref": "#/$defs/text"},
    "objective": {"$ref": "#/$defs/text"},
    "scope": {
      "type": "object", "additionalProperties": false, "required": ["workspace", "data"],
      "properties": {"workspace": {"$ref": "#/$defs/text"}, "data": {"$ref": "#/$defs/text"}}
    },
    "allowed_operations": {"$ref": "#/$defs/texts"},
    "prohibited_operations": {"$ref": "#/$defs/texts"},
    "context_refs": {"$ref": "#/$defs/texts"},
    "acceptance_criteria": {"$ref": "#/$defs/texts"},
    "approval_requirements": {"$ref": "#/$defs/texts"},
    "evidence_requirements": {"$ref": "#/$defs/texts"},
    "expires_at": {"type": "string", "format": "date-time", "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"},
    "authorization_ref": {"$ref": "#/$defs/text"},
    "resource_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["model", "provider", "max_model_calls", "deadline_seconds", "max_spawn_depth", "concurrency", "paid_fallback"],
      "properties": {
        "model": {"oneOf": [
          {"$ref": "#/$defs/text"},
          {"type": "object", "additionalProperties": false, "required": ["central", "reels", "developer", "validator"], "properties": {
            "central": {"$ref": "#/$defs/text"}, "reels": {"$ref": "#/$defs/text"},
            "developer": {"$ref": "#/$defs/text"}, "validator": {"$ref": "#/$defs/text"}
          }}
        ]},
        "provider": {"const": "openai-codex"},
        "max_model_calls": {"type": "integer", "enum": [16, 32, 48]},
        "deadline_seconds": {"type": "integer", "minimum": 1, "maximum": 600},
        "max_spawn_depth": {"type": "integer", "minimum": 1, "maximum": 2},
        "concurrency": {"const": 1},
        "paid_fallback": {"const": false}
      }
    },
    "output_contract": {
      "type": "object", "additionalProperties": false, "required": ["format", "handoff"],
      "properties": {"format": {"$ref": "#/$defs/text"}, "handoff": {"$ref": "#/$defs/texts"}}
    }
  }
}
