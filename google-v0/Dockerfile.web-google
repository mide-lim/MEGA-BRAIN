FROM node:24.19.0-bookworm-slim@sha256:e5a8dee7bc1e6a215d224a7ef8206f7e77271bc3cabd5febf2beafac0674f174 AS build
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm install --global pnpm@11.19.0 --ignore-scripts
COPY web-google/package.json web-google/pnpm-lock.yaml /app/web-google/
WORKDIR /app/web-google
RUN pnpm install --frozen-lockfile --ignore-scripts
COPY lib /app/lib
COPY web-google /app/web-google
RUN pnpm run build

FROM node:24.19.0-bookworm-slim@sha256:e5a8dee7bc1e6a215d224a7ef8206f7e77271bc3cabd5febf2beafac0674f174 AS runtime
ARG VCS_REF
LABEL org.opencontainers.image.source="https://github.com/mide-lim/MEGA-BRAIN" org.opencontainers.image.revision="$VCS_REF"
ENV MEGABRAIN_SOURCE_COMMIT=$VCS_REF
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 HOSTNAME=0.0.0.0 PORT=8080
WORKDIR /app
COPY --from=build --chown=node:node /app/web-google/.next/standalone /app
COPY --from=build --chown=node:node /app/web-google/.next/static /app/web-google/.next/static
COPY --chown=node:node config/release-source-manifest.json /app/release-source-manifest.json
RUN node -e 'const m=require("./release-source-manifest.json"); if (!/^[a-f0-9]{40}$/.test(m.commit) || m.commit !== process.env.MEGABRAIN_SOURCE_COMMIT) process.exit(1)'
USER node
EXPOSE 8080
CMD ["node","web-google/server.js"]
