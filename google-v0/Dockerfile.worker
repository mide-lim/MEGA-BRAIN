FROM node:24.19.0-bookworm-slim@sha256:e5a8dee7bc1e6a215d224a7ef8206f7e77271bc3cabd5febf2beafac0674f174
ARG VCS_REF
LABEL org.opencontainers.image.source="https://github.com/mide-lim/MEGA-BRAIN" org.opencontainers.image.revision="$VCS_REF"
ENV MEGABRAIN_SOURCE_COMMIT=$VCS_REF
ENV NODE_ENV=production PORT=8080 PATH=/opt/worker-tools/bin:$PATH
RUN apt-get update -qq && apt-get install -y --no-install-recommends ca-certificates ffmpeg=7:5.1.9-0+deb12u1 python3=3.11.2-1+b1 python3-venv=3.11.2-1+b1 && rm -rf /var/lib/apt/lists/*
COPY worker-requirements.txt /tmp/worker-requirements.txt
RUN python3 -m venv /opt/worker-tools && /opt/worker-tools/bin/pip install --no-cache-dir --no-deps --only-binary=:all: --require-hashes -r /tmp/worker-requirements.txt && /opt/worker-tools/bin/pip check && rm /tmp/worker-requirements.txt
WORKDIR /app
COPY --chown=node:node lib/analysis.mjs lib/analysis-publication.mjs lib/analysis-retry.mjs lib/usage-costs.mjs lib/source-hold.mjs lib/control-fragments.mjs lib/upload-recovery.mjs lib/controls.mjs lib/firestore-recovery.mjs lib/smart-retry.mjs lib/financial-ledger.mjs lib/batch-budget.mjs lib/firestore.mjs lib/google-operations.mjs lib/google-rest.mjs lib/links.mjs lib/media-inspector.mjs lib/media-tools.mjs lib/download-executor.mjs lib/download-supervisor.py lib/metadata-probe.mjs lib/service-identity.mjs lib/storage.mjs lib/worker-auth.mjs lib/worker-admission.mjs lib/worker-flow.mjs lib/worker-http.mjs lib/worker-queue.mjs lib/worker-reservation-gate.mjs lib/worker-runtime.mjs lib/assisted-upload.mjs lib/assisted-scope.mjs lib/assisted-pipeline.mjs lib/execution-stops.mjs lib/acquisition-control.mjs /app/lib/
COPY --chown=node:node scripts/serve-worker.mjs /app/scripts/serve-worker.mjs
COPY --chown=node:node lib/stage-contract.mjs lib/stage-upload.mjs lib/stage-transcription.mjs lib/stage-analysis.mjs /app/lib/
COPY --chown=node:node scripts/serve-stage-worker.mjs scripts/smoke-stage-workers.mjs /app/scripts/
COPY --chown=node:node config/stage-workers.example.json /app/config/stage-workers.example.json
COPY --chown=node:node lib/audio-artifact.mjs /app/lib/audio-artifact.mjs
COPY --chown=node:node lib/ongoing-costs.mjs /app/lib/ongoing-costs.mjs
COPY --chown=node:node lib/knowledge.mjs /app/lib/knowledge.mjs
COPY --chown=node:node lib/category-taxonomy.mjs /app/lib/category-taxonomy.mjs
COPY --chown=node:node lib/storage-capacity.mjs /app/lib/storage-capacity.mjs
COPY --chown=node:node scripts/smoke-worker.mjs /app/scripts/smoke-worker.mjs
COPY --chown=node:node config/analysis-preset.json /app/config/analysis-preset.json
COPY --chown=node:node lib/reels-analysis-contract.mjs lib/reels-api.mjs lib/reels-dispatcher.mjs lib/reels-finance.mjs lib/reels-google-runtime.mjs lib/reels-migration.mjs lib/reels-model.mjs lib/reels-pipeline.mjs lib/reels-quality.mjs lib/reels-repository.mjs lib/reels-runtime.mjs lib/reels-service.mjs lib/reels-speech-evidence.mjs lib/reels-taxonomy.mjs lib/links.mjs lib/billing-reconciliation.mjs /app/lib/
COPY --chown=node:node lib/reels-preserved-content.mjs /app/lib/reels-preserved-content.mjs
COPY --chown=node:node lib/reels-quality-diagnostics.mjs lib/reels-quality-gate.mjs lib/reels-quality-semantic-policy.mjs lib/reels-curation-calibration.mjs lib/reels-contextual-calibration.mjs lib/reels-contextual-projection.mjs lib/reels-contextual-index.mjs lib/reels-contextual-curation.mjs lib/reels-contextual-v2.mjs /app/lib/
COPY --chown=node:node lib/fixed-stage-runtime.mjs lib/reels-runtime-policy.mjs lib/reels-command-runner.mjs lib/reels-reconciliation.mjs /app/lib/
COPY --chown=node:node scripts/serve-reels-stage-worker.mjs /app/scripts/
COPY --chown=node:node config/release-source-manifest.json /app/release-source-manifest.json
RUN node -e 'const m=require("./release-source-manifest.json"); if (!/^[a-f0-9]{40}$/.test(m.commit) || m.commit !== process.env.MEGABRAIN_SOURCE_COMMIT) process.exit(1)'
USER node
EXPOSE 8080
CMD ["node","scripts/serve-worker.mjs"]
